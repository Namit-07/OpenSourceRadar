# Copy this file to `.env.local` and fill in the GitHub OAuth credentials.
#
# 1. Create an OAuth App: https://github.com/settings/developers → OAuth Apps → New OAuth App
#    Homepage URL:            http://localhost:3000
#    Authorization callback:  http://localhost:3000/api/auth/callback/github
# 2. Paste the generated Client ID / Client Secret below.

# Encrypts the session JWT. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Only needed for self-hosted deployments (Vercel/Cloudflare set this for you).
# Alternatively set AUTH_URL="https://your-domain.com".
AUTH_TRUST_HOST="true"

# --- Saved issues database (Turso) ---
# Saved issues are stored in a database so they follow the user's GitHub account
# across devices. This project uses Turso (SQLite-compatible, has a free tier).
#
# LOCAL DEV: leave these two blank — the app then uses a local file at
#   data/radar.db automatically (no account needed).
#
# PRODUCTION (Vercel etc.): a file DB won't persist on serverless, so create a
#   free Turso database and set these from the Vercel dashboard:
#     1. Sign up at https://turso.tech and install the CLI (`scoop install turso`
#        on Windows, or see turso.tech/docs for other platforms).
#     2. `turso db create opensource-radar`
#     3. `turso db tokens create opensource-radar`  -> paste as TURSO_AUTH_TOKEN
#     4. `turso db show opensource-radar --url`     -> paste as TURSO_DATABASE_URL
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
