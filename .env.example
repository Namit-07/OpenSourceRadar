# Copy this file to `.env.local` and fill in the GitHub OAuth credentials.
#
# 1. Create an OAuth App: https://github.com/settings/developers → OAuth Apps → New OAuth App
#    Homepage URL:            http://localhost:3000
#    Authorization callback:  http://localhost:3000/api/auth/callback/github
# 2. Paste the generated Client ID / Client Secret below.

# Encrypts the session JWT. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Only needed for self-hosted deployments (Vercel/Cloudflare set this for you).
# Alternatively set AUTH_URL="https://your-domain.com".
AUTH_TRUST_HOST="true"
